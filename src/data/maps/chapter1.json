[
  {
    "id": "chapter1",
    "name": "长安城·往事客栈",
    "rooms": [
      {
        "id": "room_203",
        "name": "二楼客房（二〇三号）",
        "description": "你从沉睡中惊醒，窗外天光微亮。隔壁传来急促的敲门声与压低的哭声。你推开房门，走廊尽头，客栈伙计跌跌撞撞地奔来——隔壁二〇二号房的商人宋怀义，死了。他那房间的门半开着，一股血腥气顺着走廊飘来。",
        "interactables": ["evt_window_look", "evt_wall_sounds", "evt_corridor_traces", "evt_ch1_wisdom_growth"],
        "exits": ["lobby", "room_202"],
        "requires": null,
        "revisitEvents": [
          {
            "id": "rev_room203_cloth_fiber",
            "requires": { "flags": ["cloth_fiber_found", "corridor_checked"], "flags_absent": ["corridor_cloth_corroborated"] },
            "text": "〔你想起刚才在走廊发现的踩痕——那人从这里经过。门框的木纹里……果然，同样的黑色纤维，极细，嵌在木刺里。凶手的衣物在经过这里时也留下了痕迹。〕",
            "grants": { "flags": ["corridor_cloth_corroborated"] }
          }
        ]
      },
      {
        "id": "room_202",
        "name": "二楼客房（二〇二号·凶案现场）",
        "description": "这就是宋怀义遇难的地方。房间陈设简单，一张架子床、一只木箱、一张小桌。床铺凌乱，枕侧有深褐色血迹已干涸发黑——奇怪的是，地板中央还有另一处污迹，与床头位置相距三步。窗棂虚掩，寒风从缝隙钻入，带起床角的布帘。门边地板上有几道细微的划痕，像是重物被拖拽过的痕迹。",
        "interactables": ["evt_body_examine", "evt_room_search", "evt_crime_scene_202", "evt_locked_room_mystery", "evt_victim_hidden_items"],
        "exits": ["room_203"],
        "requires": null,
        "talentViews": [
          {
            "talent": "望闻断骨",
            "text": "〔医者直觉：地板血迹呈圆形扩散——毒发时仰躺形成；床头血迹侧溅——搬动后补刀所致。两处，两个时间点，一个人。体温和僵硬程度也告诉你：距死亡约四至六个时辰。〕"
          },
          {
            "talent": "官威",
            "text": "〔公务直觉：死者行囊被翻动过，但只取走了特定东西，不是财物。房间的整理方式说明凶手在死亡发生后还停留了一段时间。这不是劫财，是有目标的搜查。〕"
          },
          {
            "talent": "三教九流",
            "text": "〔江湖本能：窗台绳痕是专业降绳的手法，门锁铁丝划痕是定制工具的痕迹——走过暗道的人才知道这些技巧。这个房间，被同行光顾过。〕"
          },
          {
            "talent": "望气观相",
            "text": "〔气机感知：枕角与窗台之间有一道细细的阴寒气线，是人在恐惧中拼命挣扎留下的遗痕；床脚处有一股截然不同的轻快外来气息——闯入者到过两处不同的位置。〕"
          },
          {
            "talent": "耳报神",
            "text": "〔江湖消息：隔壁二〇三号的隔音极差——昨夜若有动静，左右邻室必然听到些什么。楼下大堂那个一直喝酒的醉汉张三，说不定比他自己以为的看见了更多。〕"
          }
        ],
        "revisitEvents": [
          {
            "id": "rev_room202_arsenic",
            "requires": { "flags": ["arsenic_identified"], "flags_absent": ["poison_tea_confirmed", "rev_room202_arsenic_shown"] },
            "text": "〔后厨那堆白色粉末的气味，此刻忽然在脑中浮现。这间屋子里……宋怀义喝过的那杯茶还在床头柜上，还没人碰过。〕",
            "grants": { "flags": ["rev_room202_arsenic_shown"] }
          },
          {
            "id": "rev_room202_tunnel",
            "requires": { "flags": ["secret_tunnel_found", "door_lock_checked"], "flags_absent": ["tunnel_entry_deduced", "rev_room202_tunnel_shown"] },
            "text": "〔密道……和门锁上那几道新鲜划痕……凶手进出这间屋子的路线，或许比最初想的要复杂许多。〕",
            "grants": { "flags": ["rev_room202_tunnel_shown"] }
          }
        ]
      },
      {
        "id": "lobby",
        "name": "客栈大堂",
        "description": "油灯昏黄，几桌食客低声议论，人人面露惶恐。掌柜李福站在柜台后，神色不安，额角渗着细汗。公告板上贴着几张新旧告示，其中一张的墨迹看起来比其他新。",
        "interactables": ["npc_innkeeper_li_fu", "npc_drunk_zhang_san", "evt_notice_board", "evt_guest_register", "evt_copper_badge_examine", "evt_ch1_strength_growth"],
        "exits": ["room_203", "kitchen", "cellar", "forest", "old_mansion"],
        "requires": null,
        "talentViews": [
          {
            "talent": "耳报神",
            "text": "〔江湖消息：大堂里此刻的低声议论，你一一听进了耳中——有人昨夜没睡着，有人清晨比平时早起，有人在刻意避开某个方向的目光。每个人都在掩盖自己知道的东西。〕"
          },
          {
            "talent": "官威",
            "text": "〔公务直觉：客栈大堂的格局和掌柜的站位，让你立刻看出三四处视野盲区——昨夜从后厨方向走动的人，只要选对时机，完全可以不被柜台后的人看见。〕"
          }
        ],
        "revisitEvents": [
          {
            "id": "rev_lobby_blood_letter",
            "requires": { "flags": ["blood_letter_found"], "flags_absent": ["innkeeper_trusted", "rev_lobby_blood_letter_shown"] },
            "text": "〔枕下那枚令牌，「天机」二字……掌柜见过形形色色的人，他认不认得这块令牌？〕",
            "grants": { "flags": ["rev_lobby_blood_letter_shown"] }
          },
          {
            "id": "rev_lobby_ear_room",
            "requires": { "flags": ["ear_room_read"], "flags_absent": ["innkeeper_secret_told", "rev_lobby_ear_room_shown"] },
            "text": "〔耳室里的名录、档案……掌柜李福在这里开了十年的店。他说自己只是一个普通掌柜，但那道耳室不可能和他毫无关联。〕",
            "grants": { "flags": ["rev_lobby_ear_room_shown"] }
          },
          {
            "id": "rev_lobby_bell",
            "requires": { "flags": ["langpeng_spy_identified", "drunk_talked"], "flags_absent": ["drunk_bell_confirmed", "rev_lobby_bell_shown"] },
            "text": "〔那截铜铃残件……张三说那人腰里挂着铜铃。他认不认识这个？〕",
            "grants": { "flags": ["rev_lobby_bell_shown"] }
          },
          {
            "id": "rev_lobby_wisdom_double_kill",
            "requires": { "flags": ["synth_double_kill"], "flags_absent": ["rev_lobby_wisdom_shown"] },
            "text": "再次站在大堂，你脑海中忽然清晰起来——那双重作案手法，不只是一次犯罪的细节，而是一个习惯的印记。死亡的真相往往藏在两件事的交叠处。你开始习惯这种目光。",
            "grants": {
              "flags": ["rev_lobby_wisdom_shown"],
              "wisdom": 1,
              "storyText": "〖死亡的真相往往藏在两件事的交叠处。你开始习惯这种目光。〗"
            }
          }
        ]
      },
      {
        "id": "kitchen",
        "name": "后厨",
        "description": "灶火未熄，锅中不知煮着何物，香气与血腥混在一处。厨娘王氏坐在角落，双手捂脸，肩膀微微颤抖。灶台旁的木架上，一只药罐倒扣在地上，白色粉末撒了一地。密道的入口或许就藏在某处。",
        "interactables": ["npc_cook_wang", "evt_arsenic_trace", "evt_secret_tunnel"],
        "exits": ["lobby"],
        "requires": { "flags": ["innkeeper_talked"] },
        "talentViews": [
          {
            "talent": "望闻断骨",
            "text": "〔医者直觉：砒霜洒落的位置是从架子高处取用时失手——动手的人知道砒霜放在哪里，而不是随手翻找的。这不是第一次进这间后厨。〕"
          },
          {
            "talent": "三教九流",
            "text": "〔江湖本能：密道入口的封口工艺太专业——封缝方式、与外部的连接角度，不是随手修缮，是经过专门设计的。这条道，在案发之前很可能已经用了不止一次。〕"
          },
          {
            "talent": "耳报神",
            "text": "〔江湖消息：厨娘王氏的肩膀绷着，呼吸比正常人短促——她还有话没说。不是因为她不想说，而是因为她害怕。给她一个安全感，她会开口的。〕"
          }
        ],
        "revisitEvents": [
          {
            "id": "rev_kitchen_sequence",
            "requires": { "flags": ["murder_sequence_deduced", "cook_talked"], "flags_absent": ["cook_sequence_confirmed", "rev_kitchen_sequence_shown"] },
            "text": "〔凶手的作案顺序已经清晰——这后厨，正是他来过的地方。厨娘王氏昨夜就在这里，她知道的或许不止已经说出来的那些。〕",
            "grants": { "flags": ["rev_kitchen_sequence_shown"] }
          }
        ]
      },
      {
        "id": "cellar",
        "name": "地窖",
        "description": "青石台阶向下延伸，空气阴冷潮湿，带着陈年酒气。角落堆着十数只酒坛，最里头的石墙上有一道隐约可见的细缝，寒气从中渗出。这道缝隙后面，一定藏着什么。",
        "interactables": ["evt_cellar_mechanism", "evt_cellar_fragment", "evt_wine_jars"],
        "exits": ["lobby"],
        "requires": { "flags": ["innkeeper_trusted"] },
        "revisitEvents": [
          {
            "id": "rev_cellar_night_bloodstain",
            "requires": {
              "flags": ["innkeeper_trusted"],
              "flags_absent": ["cellar_night_seen"],
              "timeOfDay": ["night"]
            },
            "text": "〔烛光在地窖角落打出低斜的影——你这才看见，石缝里有一道细长的暗红。不是霉斑，是血，已经干透了，藏在白日的阴影里。〕",
            "grants": { "flags": ["cellar_night_seen"] }
          }
        ]
      },
      {
        "id": "forest",
        "name": "城郊树林",
        "description": "天色将暮，林间树影婆娑，偶有鸦啼。你循着大堂地面上的模糊脚印一路追来，树林深处忽有人影一闪而过。枯树旁，一名白衣人背对着你站立，衣袂随风轻扬；树林边缘的空地上，一个须发皆白的老头正摆摊卖符纸。",
        "interactables": ["npc_white_stranger", "npc_paper_seller", "evt_forest_tracks", "evt_read_wuhen_bu"],
        "exits": ["lobby", "back_alley"],
        "requires": { "flags": ["found_escape_clue"] }
      },
      {
        "id": "old_mansion",
        "name": "废弃宅院",
        "description": "朱漆大门半开，院内荒草及膝，青砖缝隙间生满苔藓。正堂横梁上悬着一块匾额，\"天机阁\"三字在尘埃下若隐若现，笔力遒劲，想来曾是何等气象。院子东侧，一口干枯的古井静静矗立，井壁上刻满了看不懂的符文。",
        "interactables": ["evt_tianji_records", "evt_mansion_ear_room", "evt_final_confrontation", "evt_dry_well", "npc_fei_ye", "evt_read_gui_bu"],
        "exits": ["lobby"],
        "requires": {
          "flags": ["clue_blood_letter_found", "clue_arsenic_found", "cellar_fragment_obtained"]
        },
        "revisitEvents": [
          {
            "id": "rev_mansion_wisdom_tianji",
            "requires": { "flags": ["synth_tianji_motive"], "flags_absent": ["rev_mansion_wisdom_shown"] },
            "text": "再次站在天机阁旧址，那块匾额的字迹忽然多了一层意味。十年前的棋局，今日才露出轮廓。你意识到，这种看见旧事深处的目光，将在日后派上用场。",
            "grants": {
              "flags": ["rev_mansion_wisdom_shown"],
              "wisdom": 1,
              "storyText": "〖十年前的棋局，今日才露出轮廓。这种感知，将在日后派上用场。〗"
            }
          }
        ]
      },
      {
        "id": "back_alley",
        "name": "城郊后巷",
        "description": "客栈背后延伸出去的一条窄巷，青砖墙壁上留着各色痕迹。白日里少有人走动，只有偶尔路过的乞丐和来往的货商。转角处，一段墙壁上的刻痕引人注目。",
        "interactables": ["npc_old_beggar", "npc_merchant_zhou", "evt_alley_marks", "evt_cargo_remnants", "evt_blue_shirt_trace"],
        "exits": ["forest"],
        "requires": { "flags": ["found_escape_clue"], "timeOfDay": ["night", "dawn"] }
      }
    ]
  }
]
